{
  "name": "planmate-monitor",
  "metadata": { "owner": "planmate-monitor", "purpose": "read-only dashboard queries" },
  "role_descriptors": {
    "planmate_monitor_read": {
      "cluster": ["monitor"],
      "indices": [
        {
          "names": ["traces-apm*", "logs-apm*", "metrics-apm*", "tourdata-refresh-logs-*"],
          "privileges": ["read", "view_index_metadata"]
        }
      ]
    }
  }
}
