# scripts/dev-server.sh 가 읽는 로컬 설정. 비밀값이 아니라 로컬 전용 고정값이다.
MONITOR_ADDR=:8080
PLANMATE_DB_URL=postgres://monitoring_ro:local@localhost:15432/planmate?sslmode=disable
COMMUNITY_DB_URL=postgres://monitoring_ro:local@localhost:15432/community?sslmode=disable
NOTIFICATION_DB_URL=postgres://monitoring_ro:local@localhost:15432/notification?sslmode=disable
# monitor 전용 DB(2단계: 스냅샷·알림). 소유자 monitor_app.
MONITOR_DB_URL=postgres://monitor_app:local@localhost:15432/monitor?sslmode=disable
ES_URL=http://localhost:9200
# ES_API_KEY 는 scripts/local-up.sh 가 local/.secrets/es_api_key 에 발급한다(ES_API_KEY_FILE).
APM_ENVIRONMENT=local
KIBANA_URL=http://localhost:5601
ACCESS_VERIFY=false
CACHE_TTL=10s
